<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">Partner Form with mailing contacts</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- The "Mailing contacts" stat button that used to sit here is
                 gone: 20.0 core ships its own on this exact anchor, with the
                 same group, pointing at the same action. Keeping ours would
                 put two of them side by side on every partner form.

                 The stats button stays, because mailing.trace.partner_id is
                 still absent from 20.0 core and so is the only way to reach a
                 partner's traces.

                 icon="bar_chart" icon_class="oi-filled", not fa-envelope-o:
                 FontAwesome is no longer bundled in 20.0 (the files are still
                 on disk but referenced by no manifest and no SCSS), so a fa-*
                 name renders a blank box and logs nothing. bar_chart also
                 stops this reading as a second copy of core's send icon. -->
            <div name="button_box" position="inside">
                <button
                    name="%(mass_mailing.mailing_trace_action)d"
                    context="{'search_default_partner_id': id,
                                  'default_partner_id': id}"
                    type="action"
                    class="oe_stat_button oe_inline"
                    icon="bar_chart"
                    icon_class="oi-filled"
                    groups="mass_mailing.group_mass_mailing_user"
                >
                    <field
                        name="mass_mailing_stats_count"
                        widget="statinfo"
                        string="Mass mailing stats"
                    />
                </button>
            </div>
        </field>
    </record>

    <record id="view_res_partner_filter" model="ir.ui.view">
        <field name="name">Partner Search with mailing contacts</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="priority" eval="20" />
        <field name="arch" type="xml">
            <field name="category_id" position="after">
                <field
                    name="mailing_contact_ids"
                    string="Mailing List"
                    filter_domain="[('mailing_contact_ids.list_ids','ilike', self)]"
                    groups="mass_mailing.group_mass_mailing_user"
                />
            </field>
        </field>
    </record>
</odoo>
